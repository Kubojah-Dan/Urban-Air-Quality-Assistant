{
  "name": "urban-air-quality-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "DayShift — Constraint-aware Urban Air Quality Assistant",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @dayshift/api dev\" \"pnpm --filter @dayshift/web dev\"",
    "dev:api": "pnpm --filter @dayshift/api dev",
    "dev:web": "pnpm --filter @dayshift/web dev",
    "start": "node apps/api/src/server.js",
    "start:api": "node apps/api/src/server.js",
    "start:web": "pnpm --filter @dayshift/web preview",
    "build": "pnpm --recursive --if-present run build",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --project tsconfig.json",
    "security:scan": "vitest run tests/security/secret-scanning.test.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.1",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "ioredis": "^6.0.0"
  }
}
