{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "strict": false,
    "types": ["node"]
  },
  "include": [
    "packages/contracts/src/**/*",
    "packages/domain/src/**/*",
    "packages/ai/src/**/*",
    "packages/guidance/src/**/*",
    "packages/emissions/src/**/*",
    "apps/api/src/errors/**/*",
    "apps/api/src/ports/**/*",
    "apps/api/src/application/**/*",
    "apps/api/src/config/**/*",
    "apps/api/src/infrastructure/auth/**/*",
    "apps/api/src/infrastructure/cache/**/*",
    "apps/api/src/infrastructure/persistence/**/*",
    "apps/api/src/middleware/**/*",
    "apps/api/src/controllers/**/*",
    "apps/api/src/composition/**/*",
    "apps/api/src/infrastructure/data-sources/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "dist",
    "coverage"
  ]
}
