rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User preferences & saved routines: Accessible ONLY by authenticated owner
    match /users/{userId}/preferences/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/plans/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Server-owned evidence records: Client read-only, NO direct client writes
    match /evidence/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Server-owned audit logs and cached upstream payloads: Fully server-side only
    match /system_audit/{document=**} {
      allow read, write: if false;
    }
    match /cache/{document=**} {
      allow read, write: if false;
    }

    // Default deny-all rule for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
