rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User preferences & plans: Managed strictly via the DayShift backend API.
    // Direct client writes are denied to enforce API validation, rate limiting, and ACL isolation.
    match /users/{userId}/preferences/{doc} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/plans/{doc} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Top-level legacy preferences collection: Deny direct client writes
    match /preferences/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Server-owned environmental evidence records: Client read-only, NO direct client writes
    match /evidence/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Server-owned audit logs and cached upstream payloads: Fully server-side only
    match /system_audit/{document=**} {
      allow read, write: if false;
    }
    match /cache/{document=**} {
      allow read, write: if false;
    }

    // Default deny-all rule for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
