# DayShift local development configuration — placeholders only.
# Never commit real API keys. Never place server keys in VITE_* variables.

NODE_ENV=development
PORT=8080
WEB_ORIGIN=http://localhost:5173

# AI providers (server side only)
AI_PRIMARY_PROVIDER=google
AI_FALLBACK_PROVIDER=groq
AI_ENABLE_FALLBACK=true
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
MODEL_REQUEST_TIMEOUT_MS=12000
MODEL_MAX_OUTPUT_TOKENS=1200
MODEL_MAX_RETRIES_PER_PROVIDER=1

# Public / official air-data sources
OPEN_METEO_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
AIRNOW_API_KEY=
CPCB_API_KEY=
OPENAQ_API_KEY=

# Shared cache and cross-instance quotas (required for hosted multi-instance mode)
CACHE_PROVIDER=redis
REDIS_URL=
CACHE_MAX_TTL_SECONDS=86400

# Optional Firebase persistence (guest-first MVP does not require these)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_AUTH_ENABLED=false
FIRESTORE_PERSISTENCE_ENABLED=false

# Client-side Firebase Web App Auth (Vite frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=

# Observability — never enable prompt or precise-location logging
LOG_LEVEL=info
LOG_SENSITIVE_FIELDS=false
