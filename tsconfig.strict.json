{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitReturns": true,
    "types": ["node"]
  },
  "include": [
    "packages/contracts/src/**/*",
    "apps/api/src/errors/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "dist",
    "coverage"
  ]
}
